<edmx:Edmx xmlns:edmx="http://schemas.microsoft.com/ado/2007/06/edmx" Version="4.0">

  <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/UI.xml">
    <edmx:Include Namespace="com.sap.vocabularies.UI.v1" Alias="UI"/>
  </edmx:Reference>

  <edmx:DataServices>
    <Schema xmlns="http://schemas.microsoft.com/ado/2008/09/edm" Namespace="local">

      <Annotations Target="V2.NorthwindModel.Product">

        <Annotation Term="UI.LineItem">
          <Collection>
            <Record Type="UI.DataField">
              <PropertyValue Property="Value" Path="ProductName"/>
            </Record>
            <Record Type="UI.DataField">
              <PropertyValue Property="Value" Path="UnitPrice"/>
            </Record>
            <Record Type="UI.DataField">
              <PropertyValue Property="Value" Path="UnitsInStock"/>
            </Record>
          </Collection>
        </Annotation>

        <Annotation Term="UI.HeaderInfo">
          <Record>
            <PropertyValue Property="TypeName" String="Product"/>
            <PropertyValue Property="TypeNamePlural" String="Products"/>
            <PropertyValue Property="Title">
              <Record Type="UI.DataField">
                <PropertyValue Property="Value" Path="ProductName"/>
              </Record>
            </PropertyValue>
          </Record>
        </Annotation>

      </Annotations>

    </Schema>
  </edmx:DataServices>
</edmx:Edmx>
